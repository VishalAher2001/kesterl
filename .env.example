# GEMINI_API_KEY: Not required for client-side agency website.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional EmailJS client-side configuration for the Contact form.
# Leave unset to display the development configuration notice and direct mailto fallback.
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""

# Optional server-side proxy URL for Brevo or transactional email relay.
# Never put private Brevo API keys in VITE_* variables.
VITE_BREVO_PROXY_URL=""
